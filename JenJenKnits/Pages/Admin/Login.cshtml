@page
@model JenJenKnits.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "登入";
}

<section class="admin-login admin-card" aria-labelledby="login-title">
    <h1 id="login-title">後台登入</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
        <label class="field">
            <span class="field-label">帳號</span>
            <input asp-for="Input.UserName" autocomplete="username" required />
        </label>
        <label class="field">
            <span class="field-label">密碼</span>
            <input asp-for="Input.Password" autocomplete="current-password" required />
        </label>
        <input type="hidden" asp-for="ReturnUrl" />
        <button class="admin-btn" type="submit">登入</button>
    </form>
</section>
