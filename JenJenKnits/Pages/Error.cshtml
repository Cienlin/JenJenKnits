@page
@model ErrorModel
@{
    ViewData["Title"] = "發生錯誤";
}

<section class="section">
    <div class="wrap">
        <div class="measure">
            <h1 class="page-title">網站出了點問題</h1>
            <p class="page-lead">請稍後重新整理頁面，或先回到作品列表。</p>
            <a class="btn" asp-page="/Products/Index">看全部作品</a>
            @if (Model.ShowRequestId)
            {
                <p class="hint">錯誤代碼：<code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</section>
