@page
@model IndexModel

<section class="hero">
    <div class="wrap hero-grid">
        <div class="hero-text">
            <h1 class="hero-title" data-yarn-title>貞心卉織</h1>
            @* 滑過或用手指劃過色點，標題會換成那個線色；純裝飾，不影響閱讀 *@
            <div class="yarn" data-yarn aria-hidden="true">
                <ul class="yarn-row">
                    @for (var i = 0; i < YarnPalette.Colors.Count; i++)
                    {
                        var yarn = YarnPalette.Colors[i];
                        <li style="--c: @yarn.Hex; --i: @i" data-hex="@yarn.Hex" data-number="@yarn.Number"></li>
                    }
                </ul>
                <p class="yarn-label" data-yarn-label hidden></p>
            </div>
            <p class="hero-lead">手鉤織的日常小物，<br />顏色可以客製。</p>
            <a class="btn" asp-page="/Products/Index">看作品</a>
        </div>
        <figure class="hero-figure">
            <img class="hero-photo" src="~/images/hero/puff-flower-lake.jpg" width="1108" height="1477" fetchpriority="high"
                 alt="湖邊的木欄杆上，套著奶茶色與橄欖綠泡芙小花提網的水壺" />
        </figure>
    </div>
</section>

<section class="section band band-pink" id="works" aria-labelledby="works-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="works-title">作品</h2>
            <a class="text-link" asp-page="/Products/Index">全部作品</a>
        </div>
        @if (Model.Featured.Count == 0)
        {
            <p class="empty">作品準備中。</p>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model.Featured)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }
    </div>
</section>

<section class="section band band-sage" id="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
        <img class="about-photo" src="~/images/about/puff-flower-glacier.jpg" width="1477" height="1108" loading="lazy"
             alt="雪山與冰河湖前，收成小花的橄欖綠提網" />
        <div class="measure">
            <h2 id="about-title">關於貞心卉織</h2>
            <p>貞心卉織 J&amp;S Crafted 做手鉤織的日常小物：提著水壺出門的提網、裝得下日常的托特包。</p>
            <p>部分作品可以從色卡挑選線的顏色，做成自己想要的配色。</p>
        </div>
    </div>
</section>

<section class="section band band-butter" id="buy" aria-labelledby="buy-title">
    <div class="wrap">
        <div class="measure">
            <h2 id="buy-title">購買方式</h2>
            @if (Model.IsOnSale)
            {
                <p>作品在 7-11 賣貨便販售。進入作品頁面，點「前往賣貨便」就能下單付款，再到 7-11 門市取貨。</p>
            }
            else
            {
                <p>作品即將在 7-11 賣貨便開賣。開賣後，每件作品頁面都會有前往賣場的按鈕，下單、付款和取貨都在賣貨便完成。</p>
            }
            @if (Model.Instagram is string instagram)
            {
                <a class="btn btn-quiet" href="@instagram" target="_blank" rel="noopener noreferrer">Instagram</a>
            }
        </div>
    </div>
</section>
