@page
@model IndexModel
@{
    // 圖號在整頁連續編號：第一屏是 Fig. 01，之後每張作品照片依序往下
    var fig = 1;
    string Fig(int n) => $"Fig. {n:00}";

    // 品牌與網站的結構化資料：搜尋引擎認得這是一個品牌與它的 Instagram，
    // 也認得網站名稱，搜尋結果就能顯示「織物製造所」而不只是網址（WebSite 只能放首頁）
    var home = Model.Site.PageUrl("/");
    var organizationId = $"{home}#organization";
    // 常見問題和頁面上的章節用同一份清單；沒有題目時不放這個節點
    var faqPage = Model.Faq.Count == 0 ? null : new Dictionary<string, object?>
    {
        ["@type"] = "FAQPage",
        ["@id"] = $"{home}#faq",
        ["mainEntity"] = Model.Faq.Select(item => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = item.Question,
            ["acceptedAnswer"] = new Dictionary<string, object?> { ["@type"] = "Answer", ["text"] = item.Answer },
        }).ToArray(),
    };
    ViewData["Seo"] = new PageSeo
    {
        JsonLd = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@graph"] = new object?[]
            {
                new Dictionary<string, object?>
                {
                    ["@type"] = "Organization",
                    ["@id"] = organizationId,
                    ["name"] = "織物製造所",
                    ["alternateName"] = "JH Craft Studio",
                    ["url"] = home,
                    ["logo"] = Model.Site.Absolute("/images/brand-icon.svg"),
                    ["description"] = "手鉤織的日常小物，顏色可以客製。",
                    ["sameAs"] = Model.Instagram is string ig ? new[] { ig } : null,
                },
                new Dictionary<string, object?>
                {
                    ["@type"] = "WebSite",
                    ["@id"] = $"{home}#website",
                    ["name"] = "織物製造所",
                    ["alternateName"] = "JH Craft Studio",
                    ["url"] = home,
                    ["publisher"] = new Dictionary<string, object?> { ["@id"] = organizationId },
                },
                faqPage,
            }.OfType<object>().ToArray(), // 拿掉沒有的節點：PageSeo 不會拿掉陣列裡的 null
        },
    };
}

<section class="wrap hero" aria-labelledby="hero-title">
    <figure class="hero-fig">
        <span class="frame">
            <img src="~/images/hero/puff-flower-lake.jpg" width="1108" height="1477" fetchpriority="high"
                 alt="湖邊的木欄杆上，套著奶茶色與橄欖綠泡芙小花提網的水壺" />
        </span>
        <figcaption><span class="mono fig">@Fig(fig++)</span>湖邊的木欄杆上，奶茶色與橄欖綠的泡芙小花提網。</figcaption>
    </figure>

    <div class="hero-copy">
        <p class="mono">Handmade Crochet · @YarnPalette.Colors.Count Colours</p>
        <p class="lead">手鉤織的<br />日常小物，<br />顏色<em>可以客製</em>。</p>
        <a class="cta" href="#works">看作品 <span aria-hidden="true">→</span></a>
        <nav class="toc" aria-label="目錄">
            <h2>目錄</h2>
            <ol>
                <li><a href="#works"><span class="mono toc-no">01</span><span class="toc-title">作品</span><span class="toc-dots"></span><span class="toc-page">p.02</span></a></li>
                <li><a href="#buy"><span class="mono toc-no">02</span><span class="toc-title">購買方式</span><span class="toc-dots"></span><span class="toc-page">p.08</span></a></li>
                @if (Model.Faq.Count > 0)
                {
                    <li><a href="#faq"><span class="mono toc-no">03</span><span class="toc-title">常見問題</span><span class="toc-dots"></span><span class="toc-page">p.10</span></a></li>
                }
            </ol>
        </nav>
    </div>

    <div class="hero-title">
        <h1 class="vtitle" id="hero-title"><span style="--i: 0">織</span><span style="--i: 1">物</span><span style="--i: 2">製</span><span style="--i: 3">造</span><span style="--i: 4">所</span></h1>
        <span class="mono vsub" aria-hidden="true">Handmade Crochet</span>
        <span class="seal" aria-hidden="true">織</span>
    </div>
</section>

<section id="works" aria-labelledby="works-title">
    <div class="wrap">
        <div class="sec-head">
            <span class="sec-no">01</span>
            <h2 id="works-title">作品</h2>
            <span class="sec-en">Works</span>
        </div>

        @if (Model.Featured.Count == 0)
        {
            <p class="empty chapter">作品準備中。</p>
        }

        @* 雜誌跨頁：奇數件照片在左、偶數件照片在右；下方最多 4 張 gallery 小圖 *@
        @for (var i = 0; i < Model.Featured.Count; i++)
        {
            var product = Model.Featured[i];
            var strip = product.GalleryImagePaths.Take(4).ToList();
            var hasSpec = product.Price is not null || product.Material is not null || product.Dimensions is not null;

            <article class="spread @(i % 2 == 1 ? "spread--rev" : null)" aria-labelledby="work-@product.Slug">
                <figure class="spread-main">
                    <a class="frame" asp-page="/Products/Detail" asp-route-slug="@product.Slug" tabindex="-1" aria-hidden="true">
                        <img src="@product.CoverImagePath" alt="" loading="@(i == 0 ? "eager" : "lazy")"
                             style="view-transition-name: @product.ViewTransitionName" />
                    </a>
                    <figcaption><span class="mono fig">@Fig(fig++)</span>@product.Name</figcaption>
                </figure>

                <div class="spread-text">
                    <p class="mono">No. @((i + 1).ToString("00"))@(product.Category is string category ? $" · {category}" : null)</p>
                    <h3 id="work-@product.Slug"><a asp-page="/Products/Detail" asp-route-slug="@product.Slug">@product.Name</a></h3>
                    @if (product.ShortDescription is string lead)
                    {
                        <p class="dek">@lead</p>
                    }
                    @if (hasSpec)
                    {
                        <dl class="spec">
                            @if (product.Price is int price)
                            {
                                <div><dt class="mono">Price</dt><dd class="price">NT$ @price.ToString("N0")</dd></div>
                            }
                            @if (product.Material is string material)
                            {
                                <div><dt class="mono">Material</dt><dd>@material</dd></div>
                            }
                            @if (product.Dimensions is string dimensions)
                            {
                                <div><dt class="mono">Size</dt><dd>@dimensions</dd></div>
                            }
                        </dl>
                    }
                    <a class="more" asp-page="/Products/Detail" asp-route-slug="@product.Slug">看這件作品 →</a>
                </div>

                @if (strip.Count > 0)
                {
                    <div class="strip">
                        @for (var s = 0; s < strip.Count; s++)
                        {
                            <figure>
                                <img src="@strip[s]" alt="@product.Name 照片 @(s + 2)" loading="lazy" />
                                <figcaption><span class="mono fig">@Fig(fig++)</span></figcaption>
                            </figure>
                        }
                    </div>
                }
            </article>
        }
    </div>
</section>

<section class="wrap chapter" id="buy" aria-labelledby="buy-title">
    <div class="sec-head">
        <span class="sec-no">02</span>
        <h2 id="buy-title">購買方式</h2>
        <span class="sec-en">How to buy</span>
    </div>

    <div class="buy-intro">
        @if (Model.IsOnSale)
        {
            <p>作品在 7-11 賣貨便販售。進入作品頁面，點「前往賣貨便」就能下單付款，再到 7-11 門市取貨。</p>
        }
        else
        {
            <span class="stamp">即將開賣</span>
            <p>作品即將在 7-11 賣貨便開賣。開賣後，每件作品頁面都會有前往賣場的按鈕，下單、付款和取貨都在賣貨便完成。</p>
        }
        @if (Model.Instagram is string instagram)
        {
            <a class="cta" href="@instagram" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
        }
    </div>

    <ol class="steps">
        <li><b>一</b><h3>進入作品頁</h3><p>點「前往賣貨便」，到賣場頁面。</p></li>
        <li><b>二</b><h3>下單付款</h3><p>下單和付款都在賣貨便完成。</p></li>
        <li><b>三</b><h3>門市取貨</h3><p>到 7-11 門市取貨。</p></li>
    </ol>
</section>

@* 全部展開不收合，像雜誌的問答欄；題目與答案和 FAQPage 結構化資料是同一份 *@
@if (Model.Faq.Count > 0)
{
    <section class="wrap chapter" id="faq" aria-labelledby="faq-title">
        <div class="sec-head">
            <span class="sec-no">03</span>
            <h2 id="faq-title">常見問題</h2>
            <span class="sec-en">FAQ</span>
        </div>

        <ol class="faq">
            @for (var i = 0; i < Model.Faq.Count; i++)
            {
                <li>
                    <span class="mono faq-no">Q.@((i + 1).ToString("00"))</span>
                    <h3>@Model.Faq[i].Question</h3>
                    <p>@Model.Faq[i].Answer</p>
                </li>
            }
        </ol>
    </section>
}
