@page "/products/{slug}"
@model JenJenKnits.Pages.Products.DetailModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["Description"] = product.ShortDescription;

    var hasSpec = product.Material is not null || product.Dimensions is not null;
    var hasColours = product.ColorChartImagePath is not null || product.ColorSimulator is not null;
    var total = Model.Images.Count;
    // 章節依實際出現的順序編號：沒有故事時「可選顏色」就是 01
    var chapter = 0;
    // 故事旁的配圖用 gallery 最後一張（通常是情境照）；沒有 gallery 就讓故事全寬
    var storyImage = product.GalleryImagePaths.Count > 0 ? product.GalleryImagePaths[^1] : null;
    string Count(int n) => $"Fig. {n:00} / {total:00}";
}

<article class="wrap">
    <nav class="mono crumbs" aria-label="麵包屑">
        <a asp-page="/Products/Index">← 全部作品</a>
        @if (product.Category is string category)
        {
            <span aria-hidden="true">/</span>
            <a asp-page="/Products/Index" asp-route-category="@category">@category</a>
        }
    </nav>

    <div class="product-top">
        <section class="gallery" data-gallery aria-label="商品照片">
            <div class="frame">
                @* 手機可左右滑動換照片；第一張帶 view-transition-name，從作品卡片點進來時照片會平滑放大 *@
                <div class="gallery-track" data-gallery-track tabindex="0" aria-label="商品照片，可左右滑動">
                    @for (var i = 0; i < total; i++)
                    {
                        <img class="gallery-slide" src="@Model.Images[i]" alt="@product.Name 第 @(i + 1) 張照片"
                             loading="@(i == 0 ? "eager" : "lazy")"
                             style="@(i == 0 ? $"view-transition-name: {product.ViewTransitionName}" : null)" />
                    }
                </div>
                @if (total > 1)
                {
                    <button class="gallery-btn gallery-prev" type="button" data-gallery-prev aria-label="上一張" disabled>←</button>
                    <button class="gallery-btn gallery-next" type="button" data-gallery-next aria-label="下一張">→</button>
                }
            </div>
            <p class="gallery-cap"><span class="mono fig" data-gallery-count>@Count(1)</span>@product.Name</p>
            @if (total > 1)
            {
                <ol class="gallery-thumbs" aria-label="選擇照片">
                    @for (var i = 0; i < total; i++)
                    {
                        <li>
                            <button type="button" data-gallery-thumb aria-label="看第 @(i + 1) 張照片"
                                    aria-current="@(i == 0 ? "true" : "false")">
                                <img src="@Model.Images[i]" alt="" loading="lazy" />
                            </button>
                        </li>
                    }
                </ol>
            }
        </section>

        <div class="detail-info">
            <p class="mono">No. @Model.Number.ToString("00")@(product.Category is string cat ? $" · {cat}" : null)</p>
            <h1>@product.Name</h1>
            @if (product.Price is int price)
            {
                <p class="price">NT$ @price.ToString("N0")</p>
            }
            @if (product.ShortDescription is string lead)
            {
                <p class="dek">@lead</p>
            }

            @if (hasSpec)
            {
                <dl class="spec">
                    @if (product.Material is string material)
                    {
                        <div><dt class="mono">Material</dt><dd>@material</dd></div>
                    }
                    @if (product.Dimensions is string dimensions)
                    {
                        <div><dt class="mono">Size</dt><dd>@dimensions</dd></div>
                    }
                </dl>
            }

            <div class="buy-box">
                @if (product.BuyUrl is string buyUrl)
                {
                    <a class="btn" href="@buyUrl" target="_blank" rel="noopener noreferrer">前往賣貨便</a>
                    <p class="hint">價格與庫存以賣貨便頁面為準。</p>
                    @if (Model.Instagram is string instagram)
                    {
                        <a class="btn btn-quiet" href="@instagram" target="_blank" rel="noopener noreferrer">私訊詢問客製顏色</a>
                    }
                }
                else if (Model.Instagram is string instagram)
                {
                    <a class="btn" href="@instagram" target="_blank" rel="noopener noreferrer">私訊訂購／客製顏色</a>
                    <p class="hint">賣貨便賣場準備中。</p>
                }
                else
                {
                    <p class="pending">即將開賣</p>
                    <p class="hint">賣貨便賣場準備中。</p>
                }
            </div>

            @if (hasColours)
            {
                <a class="more jump" href="#colours">挑配色 ↓</a>
            }
        </div>
    </div>

    @if (product.StoryHtml is string story)
    {
        <section class="chapter" aria-labelledby="story-title">
            <div class="sec-head">
                <span class="sec-no">@((++chapter).ToString("00"))</span>
                <h2 id="story-title">故事</h2>
                <span class="sec-en">Story</span>
            </div>
            <div class="story-grid">
                <div class="story">@Html.Raw(story)</div>
                @if (storyImage is not null)
                {
                    <figure class="story-fig">
                        <span class="frame"><img src="@storyImage" alt="@product.Name 情境照" loading="lazy" /></span>
                        <figcaption><span class="mono fig">@Count(total)</span>@product.Name</figcaption>
                    </figure>
                }
            </div>
        </section>
    }

    @if (hasColours)
    {
        <section class="chapter" id="colours" aria-labelledby="colours-title">
            <div class="sec-head">
                <span class="sec-no">@((++chapter).ToString("00"))</span>
                <h2 id="colours-title">可選顏色</h2>
                <span class="sec-en">Colours</span>
            </div>
            @if (product.ColorSimulator == "puff-flower")
            {
                <p class="colours-intro">點選色票試試看配色，訂購時告訴我們兩個色號即可。</p>
                <partial name="_PuffFlowerSimulator" />
            }
            else
            {
                <p class="colours-intro">從色卡挑選線的顏色，色號標在每球線上。</p>
            }
            @if (product.ColorChartImagePath is string colorChart)
            {
                <figure class="chart">
                    <span class="frame"><img src="@colorChart" alt="線材色卡，每一球線上標有色號" loading="lazy" /></span>
                    <figcaption><span class="mono fig">Colours</span>線材色卡，色號標在每一球線上。</figcaption>
                </figure>
            }
        </section>
    }

    @if (Model.Next is Product next)
    {
        <nav class="next" aria-label="下一件作品">
            <a asp-page="/Products/Detail" asp-route-slug="@next.Slug">
                <img src="@next.CoverImagePath" alt="" loading="lazy" />
                <span>
                    <span class="mono">Next@(next.Category is string nextCategory ? $" · {nextCategory}" : null)</span>
                    <b>@next.Name</b>
                </span>
                <span class="next-arrow" aria-hidden="true">→</span>
            </a>
        </nav>
    }
</article>
