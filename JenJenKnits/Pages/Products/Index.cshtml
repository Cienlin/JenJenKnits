@page
@model JenJenKnits.Pages.Products.IndexModel
@{
    // 標題與描述列出目前有的分類，商品上下架時自動跟著變
    var types = string.Join("、", Model.Categories);
    ViewData["Title"] = !string.IsNullOrEmpty(Model.Category) ? $"{Model.Category}｜作品"
        : types.Length > 0 ? $"作品：手鉤織{types}" : "作品";
    ViewData["Description"] = types.Length > 0
        ? $"織物製造所的全部作品：手鉤織的{types}等日常小物，每件都可以從 {YarnPalette.Colors.Count} 色線材挑選顏色。"
        : "織物製造所的全部作品：手鉤織的日常小物。";
    // 分類篩選是 /products 的子集，canonical 指回主列表
    ViewData["Seo"] = new PageSeo { CanonicalPath = "/products" };
}

<section class="wrap page" aria-labelledby="page-title">
    <div class="sec-head">
        <span class="sec-no">01</span>
        <h1 id="page-title">作品</h1>
        <span class="sec-en">All works</span>
    </div>

    @if (Model.Categories.Count > 0)
    {
        <nav class="filters" aria-label="依分類篩選">
            <a asp-page="/Products/Index" aria-current="@(string.IsNullOrEmpty(Model.Category) ? "page" : null)">全部</a>
            @foreach (var category in Model.Categories)
            {
                <a asp-page="/Products/Index" asp-route-category="@category"
                   aria-current="@(category == Model.Category ? "page" : null)">@category</a>
            }
        </nav>
    }

    @if (Model.Products.Count > 0)
    {
        <div class="catalog">
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Category))
    {
        <div class="chapter">
            <p class="empty">此分類目前無商品。</p>
            <a class="more" asp-page="/Products/Index">回全部作品</a>
        </div>
    }
    else
    {
        <p class="empty chapter">作品準備中。</p>
    }
</section>
