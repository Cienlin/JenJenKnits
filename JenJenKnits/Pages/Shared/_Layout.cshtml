<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title}｜貞心卉織 J&S Crafted" : "貞心卉織 J&S Crafted｜手鉤織的日常小物")</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? "貞心卉織 J&S Crafted，手鉤織的日常小物，顏色可以客製。")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Huninn&family=Noto+Sans+TC:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JenJenKnits.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="site-header">
        <div class="wrap site-header-inner">
            <a class="brand" asp-page="/Index">
                <img src="~/images/logo/logo-mark.png" alt="" width="40" height="40" />
                <span>貞心卉織</span>
            </a>
            <nav class="site-nav" aria-label="主選單">
                <a asp-page="/Products/Index">作品</a>
                <a asp-page="/Index" asp-fragment="about">關於</a>
                <a asp-page="/Index" asp-fragment="buy">購買方式</a>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer band band-mist">
        <div class="wrap site-footer-inner">
            <img class="footer-logo" src="~/images/logo/logo-full-sm.png" alt="貞心卉織 J&S Crafted" width="112" height="91" />
            <nav class="footer-nav" aria-label="頁尾選單">
                <a asp-page="/Products/Index">作品</a>
                <a asp-page="/Index" asp-fragment="about">關於</a>
                <a asp-page="/Index" asp-fragment="buy">購買方式</a>
            </nav>
            <p class="version">@AppVersion.Display</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
