@{
    // 刊頭導覽標示目前所在的區段：作品列表與商品頁都算「作品」
    var path = Context.Request.Path.Value ?? "";
    var inWorks = path.StartsWith("/products", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title}｜貞心卉織 J&S Crafted" : "貞心卉織 J&S Crafted｜手鉤織的日常小物")</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? "貞心卉織 J&S Crafted，手鉤織的日常小物，顏色可以客製。")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JenJenKnits.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="masthead">
        <div class="wrap">
            <div class="masthead-top">
                <span class="mono masthead-issue">No. 01 — 手鉤織的日常小物</span>
                <a class="masthead-logo" asp-page="/Index" aria-label="貞心卉織 J&S Crafted 首頁">J&amp;S <em>Crafted</em></a>
                <nav class="masthead-nav" aria-label="主選單">
                    <a asp-page="/Products/Index" aria-current="@(inWorks ? "page" : null)">作品</a>
                    <a asp-page="/Index" asp-fragment="buy">購買方式</a>
                </nav>
            </div>
            @* 印刷色條：22 色線材，純裝飾 *@
            <ol class="colorbar" aria-hidden="true">
                @for (var i = 0; i < YarnPalette.Colors.Count; i++)
                {
                    var yarn = YarnPalette.Colors[i];
                    <li style="--c: @yarn.Hex; --i: @i">@yarn.Number.ToString("00")</li>
                }
            </ol>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="colophon">
        <div class="wrap">
            <div class="colophon-grid">
                <img class="colophon-logo" src="~/images/logo/logo_white_on_black-transparent.png" alt="貞心卉織 J&S Crafted" width="150" />
                <div>
                    <h2>版權頁</h2>
                    <dl>
                        <div><dt>品牌</dt><dd>貞心卉織 J&amp;S Crafted</dd></div>
                        <div><dt>內容</dt><dd>手鉤織的日常小物</dd></div>
                        <div><dt>線材色卡</dt><dd>Excel LOTTO EX088・22 色</dd></div>
                        <div><dt>販售</dt><dd>7-11 賣貨便</dd></div>
                    </dl>
                </div>
                <nav class="colophon-nav" aria-label="頁尾選單">
                    <a asp-page="/Products/Index">作品</a>
                    <a asp-page="/Index" asp-fragment="buy">購買方式</a>
                </nav>
            </div>
            <p class="mono version">@AppVersion.Display</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
