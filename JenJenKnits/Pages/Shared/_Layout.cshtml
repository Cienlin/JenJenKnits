@{
    // 刊頭導覽標示目前所在的區段：作品列表與商品頁都算「作品」
    var path = Context.Request.Path.Value ?? "";
    var inWorks = path.StartsWith("/products", StringComparison.OrdinalIgnoreCase);
    // 首頁才播開場動畫（色條印上去）；其他頁換頁時刊頭保持不動
    var isHome = path == "/";

    // 搜尋引擎與社群分享：網址一律用 Site:BaseUrl 組成的絕對網址
    var site = SiteOptions.Value;
    var seo = ViewData["Seo"] as PageSeo ?? new PageSeo();
    var pageTitle = ViewData["Title"] is string title ? $"{title}｜織物製造所" : "織物製造所｜手鉤織的日常小物";
    var description = ViewData["Description"] as string ?? "織物製造所，手鉤織的日常小物，顏色可以客製。";
    var canonical = site.PageUrl(seo.CanonicalPath ?? path);
}
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> SiteOptions
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:site_name" content="織物製造所" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content="@seo.Type" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@site.Absolute(seo.Image ?? PageSeo.DefaultImage)" />
    <meta name="twitter:card" content="summary_large_image" />
    @if (seo.JsonLd is not null)
    {
        @* 整段直接輸出：寫成 Razor 標籤時 type 裡的 + 會被編碼成 &#x2B; *@
        @Html.Raw($"<script type=\"application/ld+json\">{PageSeo.Serialize(seo.JsonLd)}</script>")
    }
    <link rel="icon" type="image/svg+xml" href="~/images/brand-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JenJenKnits.styles.css" asp-append-version="true" />
</head>
<body class="@(isHome ? "is-home" : null)">
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="masthead">
        <div class="wrap">
            <div class="masthead-top">
                <span class="mono masthead-issue">No. 01 — 手鉤織的日常小物</span>
                <a class="masthead-logo" asp-page="/Index" aria-label="織物製造所首頁">織物製造所</a>
                <nav class="masthead-nav" aria-label="主選單">
                    <a asp-page="/Products/Index" aria-current="@(inWorks ? "page" : null)">作品</a>
                    <a asp-page="/Index" asp-fragment="buy">購買方式</a>
                </nav>
            </div>
            @* 印刷色條：22 色線材，純裝飾 *@
            <ol class="colorbar" aria-hidden="true">
                @for (var i = 0; i < YarnPalette.Colors.Count; i++)
                {
                    var yarn = YarnPalette.Colors[i];
                    <li style="--c: @yarn.Hex; --i: @i">@yarn.Number.ToString("00")</li>
                }
            </ol>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="colophon">
        <div class="wrap">
            <div class="colophon-grid">
                <a class="colophon-logo" asp-page="/Index" aria-label="織物製造所首頁">織物製造所<span aria-hidden="true">手鉤織的日常小物</span></a>
                <div>
                    <h2>版權頁</h2>
                    <dl>
                        <div><dt>品牌</dt><dd>織物製造所</dd></div>
                        <div><dt>內容</dt><dd>手鉤織的日常小物</dd></div>
                        <div><dt>線材色卡</dt><dd>Excel LOTTO EX088・22 色</dd></div>
                        <div><dt>販售</dt><dd>7-11 賣貨便</dd></div>
                    </dl>
                </div>
                <nav class="colophon-nav" aria-label="頁尾選單">
                    <a asp-page="/Products/Index">作品</a>
                    <a asp-page="/Index" asp-fragment="buy">購買方式</a>
                </nav>
            </div>
            <p class="mono version">@AppVersion.Display</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
